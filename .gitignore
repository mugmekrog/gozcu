.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# .env is tracked by team decision: this is a private repo and everyone needs the
# GLM gateway key to run the agent layer. The key is therefore in this
# repository's history permanently. If this repo is ever made public, rotate the
# key with the organizers first -- removing the file will not remove it from history.
# .env
data/processed/
!data/processed/.gitkeep
contracts/openapi.json

# frontend
# Per-machine Vite config. web/.env.local is where VITE_STT_URL lives, and the
# speech service's address is a local choice, not a team one.
web/.env.local
web/node_modules/
web/dist/
# Generated from the real pipeline by web/scripts/export_fixtures.py.
# Derived data, and 14 MB of it -- regenerate rather than commit.
web/public/fixtures/

# Deployment & credentials
cloudrun-env.yaml
.firebase/

