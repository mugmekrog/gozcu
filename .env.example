# Goru environment template. Existing .env is committed in this private repo.
# Rotate both GLM and Typesafe credentials before widening repository access;
# removing .env later will not remove credentials from Git history.

# GLM gateway (organizers' OpenAI-compatible LiteLLM proxy). $15 lifetime budget.
GLM_API_KEY=

# Demo users (S0.3). Passwords are bcrypt-hashed at seed time, never logged.
GORU_STEWARD_PASSWORD=change-me-steward
GORU_REVIEWER_PASSWORD=change-me-reviewer
GORU_ADMIN_PASSWORD=change-me-admin

# Where the display finds the local speech service (services/api/app/api/stt_server.py).
# Unset means speech is off and the microphone is disabled with a reason, which is
# the shipped default: the display still boots and runs with no service at all.
# This is a Vite variable, so it belongs in web/.env.local for the dev server:
#   VITE_STT_URL=http://127.0.0.1:8800
